{
  "expo": {
    "name": "Beast Maragames",
    "slug": "maragames-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maragamesapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.beastmaragames.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0E1015",
            "image": "./assets/images/splash-logo-dark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a4598502-a299-4533-8e42-cd598eab3d14"
      }
    },
    "owner": "tiagopbc"
  }
}
