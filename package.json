{
  "name": "maragames-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo/ui": "~58.0.22",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.32.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "seed:conteudo": "node ./scripts/seed-conteudo.js",
    "seed:conteudo:check": "node ./scripts/seed-conteudo.js --dry-run",
    "exportar": "tsx ./scripts/exportar-piloto.ts",
    "relatorio": "tsx ./scripts/gerar-relatorio.ts",
    "limpar:teste": "node ./scripts/limpar-dados-de-teste.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:regras": "firebase emulators:exec --only firestore --project demo-maragames \"jest --config jest.regras.config.js\""
  },
  "jest": {
    "projects": [
      {
        "displayName": "nativo",
        "preset": "jest-expo",
        "setupFiles": [
          "<rootDir>/src/test/registro-de-assets.js"
        ],
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/src/test/estilo-vazio.js",
          "^@/assets/(.*)$": "<rootDir>/assets/$1",
          "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/regras/",
          "<rootDir>/.claude/",
          "\\.test\\.web\\.[jt]sx?$"
        ]
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "transform": {
          "\\.[jt]sx?$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ],
              "caller": {
                "name": "metro",
                "bundler": "metro",
                "platform": "web"
              }
            }
          ]
        },
        "moduleNameMapper": {
          "^react-native$": "react-native-web",
          "\\.css$": "<rootDir>/src/test/estilo-vazio.js",
          "^@/assets/(.*)$": "<rootDir>/assets/$1",
          "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
        },
        "testMatch": [
          "<rootDir>/src/**/*.test.web.[jt]s?(x)"
        ]
      }
    ]
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
